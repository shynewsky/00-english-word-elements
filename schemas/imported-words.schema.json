{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shynewsky.github.io/english-word-elements/schemas/imported-words.schema.json",
  "title": "Generated imported word records",
  "type": "object",
  "required": ["meta", "words"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generatedAt", "wordCount", "candidateCount", "sources", "noteKo"]
    },
    "words": {
      "type": "array",
      "items": { "$ref": "catalog.schema.json#/$defs/word" }
    }
  },
  "additionalProperties": false
}

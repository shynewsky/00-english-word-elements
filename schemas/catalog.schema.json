{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shynewsky.github.io/english-word-elements/schemas/catalog.schema.json",
  "title": "English Word Elements catalog",
  "type": "object",
  "required": ["meta", "sources", "concepts", "elements", "words"],
  "properties": {
    "meta": { "type": "object", "required": ["project", "schemaVersion", "dataVersion"] },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "words": { "type": "array", "items": { "$ref": "#/$defs/word" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-._][a-z0-9]+)*$" },
    "status": { "enum": ["draft", "reviewed", "published"] },
    "allomorph": {
      "type": "object",
      "required": ["form", "conditionKo"],
      "properties": {
        "form": { "type": "string", "minLength": 1 },
        "conditionKo": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "wordMeaning": {
      "type": "object",
      "required": ["id", "ko", "en", "concepts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ko": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "concepts": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "wordForm": {
      "type": "object",
      "required": ["form", "type"],
      "properties": {
        "form": { "type": "string", "minLength": 1 },
        "type": { "enum": ["third-person", "third-person/plural", "past", "past-participle", "present-participle", "plural", "comparative", "superlative", "variant"] }
      },
      "additionalProperties": false
    },
    "wordRelation": {
      "type": "object",
      "required": ["type", "targetWordId", "transparency", "noteKo"],
      "properties": {
        "type": { "enum": ["derived-from", "compound", "variant-of", "related-family"] },
        "targetWordId": { "$ref": "#/$defs/id" },
        "transparency": { "enum": ["transparent", "semi-transparent", "opaque"] },
        "categoryChange": { "type": "string" },
        "noteKo": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "analysisPart": {
      "type": "object",
      "required": ["order", "parentOrder", "surface", "role"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "parentOrder": { "type": ["integer", "null"], "minimum": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "role": { "enum": ["base", "prefix", "suffix", "root"] },
        "elementSenseId": { "$ref": "#/$defs/id" },
        "wordId": { "$ref": "#/$defs/id" },
        "boundaryChangeNote": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["elementSenseId"], "not": { "required": ["wordId"] } },
        { "required": ["wordId"], "not": { "required": ["elementSenseId"] } }
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["id", "wordSenseId", "mode", "transparency", "explanationKo", "parts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "wordSenseId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["synchronic", "etymological"] },
        "transparency": { "enum": ["transparent", "semi-transparent", "opaque"] },
        "explanationKo": { "type": "string", "minLength": 1 },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analysisPart" } }
      },
      "additionalProperties": false
    },
    "elementExample": {
      "type": "object",
      "required": ["wordId", "mode", "noteKo"],
      "properties": {
        "wordId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["synchronic", "etymological"] },
        "noteKo": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "elementSense": {
      "type": "object",
      "required": ["id", "glossKo", "glossEn", "concepts", "function", "categoryChange", "productivity", "usageNoteKo", "etymologyNoteKo", "examples", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "glossKo": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "glossEn": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "concepts": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "function": { "type": "string", "minLength": 1 },
        "categoryChange": { "type": ["string", "null"] },
        "productivity": { "type": "string", "minLength": 1 },
        "usageNoteKo": { "type": "string", "minLength": 1 },
        "etymologyNoteKo": { "type": "string", "minLength": 1 },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/elementExample" } },
        "coverageWaiverKo": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "license", "role"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "license": { "type": "string" }, "role": { "type": "string" } },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": ["id", "labels", "descriptionKo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "labels": {
          "type": "object",
          "required": ["ko", "en"],
          "properties": {
            "ko": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "descriptionKo": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": ["id", "canonicalForm", "kind", "originLanguage", "bound", "allomorphs", "senses", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "canonicalForm": { "type": "string" },
        "kind": { "enum": ["prefix", "suffix", "root", "combining-form", "infix", "circumfix"] },
        "originLanguage": { "type": "string" }, "bound": { "type": "boolean" },
        "allomorphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/allomorph" } }, "senses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/elementSense" } }, "status": { "$ref": "#/$defs/status" }
      },
      "additionalProperties": false
    },
    "word": {
      "type": "object",
      "required": ["id", "lemma", "partOfSpeech", "status", "meanings", "forms", "relations", "analyses", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "lemma": { "type": "string", "minLength": 1 }, "partOfSpeech": { "type": "array", "minItems": 1, "items": { "enum": ["noun", "verb", "adjective", "adverb"] } },
        "status": { "$ref": "#/$defs/status" }, "meanings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/wordMeaning" } },
        "forms": { "type": "array", "items": { "$ref": "#/$defs/wordForm" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/wordRelation" } }, "analyses": { "type": "array", "items": { "$ref": "#/$defs/analysis" } },
        "pronunciations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ipa"],
            "properties": {
              "ipa": { "type": "string", "minLength": 1 },
              "variety": { "type": "string" },
              "audioUrl": { "type": "string", "format": "uri" },
              "sourceId": { "$ref": "#/$defs/id" }
            },
            "additionalProperties": false
          }
        },
        "etymology": {
          "type": "object",
          "required": ["summaryKo"],
          "properties": {
            "summaryKo": { "type": "string", "minLength": 1 },
            "summaryEn": { "type": "string" },
            "originLanguages": { "type": "array", "items": { "type": "string" } },
            "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          },
          "additionalProperties": false
        },
        "familyHeadwordId": { "$ref": "#/$defs/id" },
        "familySummaryKo": { "type": "string" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    }
  }
}
